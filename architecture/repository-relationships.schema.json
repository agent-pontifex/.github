{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "composition_policy": {
      "type": "object"
    },
    "interoperability_policy": {
      "properties": {
        "contract": {
          "type": "string"
        },
        "human_identity_authority": {
          "const": "platform://shared-auth"
        },
        "machine_identity_authority": {
          "const": "platform://fiducia-cloud"
        },
        "package_and_artifact_authority": {
          "const": "platform://zed-pkg"
        },
        "protocol_authority": {
          "const": "agent-pontifex/agent-sdk.rs"
        },
        "repository_write_authority": {
          "const": "platform://fiducia-cloud"
        },
        "secret_encryption_authority": {
          "const": "platform://sops"
        },
        "secret_materialization_policy": {
          "type": "object"
        }
      },
      "required": [
        "contract",
        "protocol_authority",
        "repository_write_authority",
        "human_identity_authority",
        "machine_identity_authority",
        "package_and_artifact_authority",
        "secret_encryption_authority",
        "secret_materialization_policy"
      ],
      "type": "object"
    },
    "organization": {
      "type": "string"
    },
    "privacy": {
      "type": "object"
    },
    "registry_repository": {
      "pattern": "^[^/]+/\\.github$",
      "type": "string"
    },
    "relationships": {
      "type": "array"
    },
    "repositories": {
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schema_version",
    "organization",
    "registry_repository",
    "privacy",
    "repositories",
    "relationships",
    "composition_policy",
    "interoperability_policy"
  ],
  "title": "Organization repository relationships",
  "type": "object"
}
