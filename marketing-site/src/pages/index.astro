---
const features = [
  ["Discover before trust", "Bridge and coordinator clients negotiate a versioned public service descriptor before invoking capabilities."],
  ["Credential-safe transport", "Sensitive bearer headers, disabled redirects, bounded response bodies, and encoded path segments are SDK defaults."],
  ["Typed coordination", "Presence, messaging, context, repository-path leases, and coordinator jobs share explicit Rust contracts."],
  ["Namespaced authority", "Fiducia-specific tenancy, review, fencing, and storage semantics remain downstream extensions—not hidden protocol dependencies."],
  ["Conformance fixtures", "Checked-in descriptors make compatibility reviewable and keep bridge implementations honest."],
  ["Vendor-neutral seams", "Agents can cooperate across providers without handing one vendor the meaning of every task or capability."],
];
const samples = [
  { id:"rust", label:"Rust SDK", file:"discover.rs", code:`use agent_pontifex_sdk::Client;

let client = Client::new("https://bridge.example.com")?
    .with_bearer(std::env::var("AGENT_PONTIFEX_TOKEN")?)?;

let bridge = client.bridge();
let service = bridge.discover().await?;

println!(
    "{} protocol v{}",
    service.descriptor.implementation,
    service.negotiated_protocol_major,
);`, note:"Exact public SDK entry points. Credentials stay in sensitive headers and redirects are disabled." },
  { id:"descriptor", label:"Conformance JSON", file:"bridge.json", code:`{
  "schema_version": 1,
  "protocol": "agent-pontifex.bridge",
  "protocol_versions": { "min_major": 1, "max_major": 1 },
  "service": "bridge",
  "implementation": "agent-pontifex-community",
  "capabilities": [
    "bridge.agents.register",
    "bridge.messages.post",
    "bridge.context.read",
    "bridge.repository-path-leases.acquire",
    "bridge.transports.websocket"
  ],
  "extensions": {}
}`, note:"A shortened view of the checked-in bridge conformance descriptor." },
  { id:"curl", label:"HTTP discovery", file:"discover.sh", code:`curl --fail-with-body \
  --header "accept: application/json" \
  https://bridge.example.com/.well-known/agent-pontifex

# Validate service kind, protocol range, capabilities,
# and namespaced extensions before calling protected routes.`, note:"Protocol discovery is public; protected operations use the credential-safe SDK client." },
];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Vendor-neutral bridge, coordinator, and SDK contracts for cooperating AI agents."><meta name="theme-color" content="#0a1020"><title>Agent Pontifex — coordination without surrender</title></head><body>
<header><a class="brand" href="/"><b>AP</b><span>Agent Pontifex</span></a><nav><a href="#platform">Protocol</a><a href="#clients">SDK</a><a href="https://github.com/agent-pontifex">GitHub ↗</a></nav></header>
<main>
<section class="hero"><div><p class="eyebrow">Open agent infrastructure · Rust-first</p><h1>Connect specialist agents without <em>surrendering control.</em></h1><p class="lede">Agent Pontifex defines a vendor-neutral bridge and coordinator boundary for discovery, presence, messaging, context, repository leases, and jobs—with authority kept explicit and extensions namespaced.</p><div class="actions"><a class="primary" href="https://github.com/agent-pontifex/agent-sdk.rs">Explore the SDK ↗</a><a href="#clients">Inspect the contract</a></div><ul><li>Versioned discovery</li><li>Credential-safe clients</li><li>Conformance fixtures</li></ul></div>
<div class="visual" aria-label="Bridge and coordinator protocol map"><span class="grid"></span><div class="node core"><small>PROTOCOL</small><strong>v1 negotiated</strong><i>one public contract</i></div><div class="node n1"><small>BRIDGE</small><b>messages · context</b></div><div class="node n2"><small>COORDINATOR</small><b>jobs · claims</b></div><div class="node n3"><small>AUTHORITY</small><b>namespaced</b></div><div class="node n4"><small>TRANSPORT</small><b>bounded</b></div><svg viewBox="0 0 500 420" aria-hidden="true"><path d="M250 210L105 90M250 210L398 90M250 210L105 330M250 210L398 330"/></svg></div></section>
<section class="metrics"><div><b>2</b><span>service kinds</span></div><div><b>1</b><span>versioned protocol</span></div><div><b>4 MiB</b><span>response bound</span></div><div><b>0</b><span>implicit redirects</span></div></section>
<section id="platform" class="platform"><p class="eyebrow">Coordination as a contract</p><h2>Enough structure to cooperate. Enough separation to stay sovereign.</h2><p class="intro">The SDK is deliberately smaller than a control plane. It standardizes discovery and coordination while leaving tenant policy, human review, fencing, and storage to downstream systems that advertise those semantics explicitly.</p><div class="features">{features.map(([title,body],i)=><article><small>{String(i+1).padStart(2,"0")}</small><h3>{title}</h3><p>{body}</p></article>)}</div></section>
<section id="clients" class="sdk" data-sdk><div><p class="eyebrow">SDK workbench</p><h2>Start with the Rust client. Inspect the wire contract beside it.</h2><p class="intro">Agent Pontifex currently publishes a Rust SDK and protocol crate, not a fictional multi-language matrix. The selector pairs exact SDK entry points with the public descriptor and HTTP discovery boundary.</p><a class="source" href="https://github.com/agent-pontifex/agent-sdk.rs">Browse agent-sdk.rs ↗</a></div><div class="workbench"><div class="toolbar"><label><span>Example</span><select aria-label="Select client language" data-language>{samples.map((s,i)=><option value={s.id} selected={i===0}>{s.label}</option>)}</select></label><code data-file>{samples[0]?.file ?? "discover.rs"}</code><button type="button" data-copy>Copy</button></div>{samples.map((s,i)=><article data-sample={s.id} data-name={s.file} hidden={i!==0}><pre tabindex="0"><code>{s.code}</code></pre><p>{s.note}</p></article>)}</div></section>
<section class="closing"><p class="eyebrow">Build bridges, not lock-in</p><h2>Give agents a common language without giving away the keys.</h2><a href="https://github.com/agent-pontifex">Open the organization ↗</a></section>
</main><footer><span>© 2026 Agent Pontifex</span><a href="https://github.com/agent-pontifex/agent-sdk.rs">Protocol and SDK</a></footer>
<script is:inline>document.querySelectorAll('[data-sdk]').forEach((root)=>{const select=root.querySelector('[data-language]');const file=root.querySelector('[data-file]');const copy=root.querySelector('[data-copy]');const panels=[...root.querySelectorAll('[data-sample]')];const show=(id)=>panels.forEach((p)=>{const active=p.dataset.sample===id;p.hidden=!active;if(active)file.textContent=p.dataset.name||''});select?.addEventListener('change',(e)=>show(e.target.value));copy?.addEventListener('click',async()=>{const active=panels.find((p)=>!p.hidden);const text=active?.querySelector('code')?.textContent||'';try{await navigator.clipboard.writeText(text);copy.textContent='Copied'}catch{active?.querySelector('pre')?.focus();copy.textContent='Select code'}setTimeout(()=>copy.textContent='Copy',1200)})});</script>
<style>:root{--accent:#8b5cf6;--hot:#22d3ee;--ink:#0a1020;--muted:#64748b;--paper:#f6f5ff}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;overflow-x:hidden;background:linear-gradient(180deg,#eef2ff,var(--paper) 36rem);color:var(--ink);font:16px/1.6 Inter,ui-sans-serif,system-ui,sans-serif}a{color:inherit}header,main,footer{width:min(1180px,calc(100% - 2rem));margin:auto}header{display:flex;align-items:center;justify-content:space-between;padding:1.1rem 0}.brand{display:flex;gap:.6rem;align-items:center;font-weight:900;text-decoration:none}.brand b{display:grid;width:2.35rem;aspect-ratio:1;place-items:center;border-radius:.72rem;background:var(--ink);color:white;font-size:.75rem}nav{display:flex;gap:1.25rem;font-size:.86rem;font-weight:800}nav a{text-decoration:none}.hero{display:grid;grid-template-columns:1.04fr .96fr;gap:clamp(2rem,7vw,7rem);align-items:center;min-height:720px;padding:5rem 0}.eyebrow{margin:0;color:var(--accent);font:800 .7rem/1 ui-monospace,monospace;letter-spacing:.17em;text-transform:uppercase}h1{max-width:12ch;margin:.8rem 0 1.25rem;font-size:clamp(3.5rem,8vw,7rem);line-height:.86;letter-spacing:-.075em}h1 em{background:linear-gradient(120deg,var(--accent),var(--hot));background-clip:text;color:transparent;font-style:normal}.lede,.intro{max-width:47rem;color:var(--muted);font-size:1.08rem}.actions{display:flex;gap:.7rem;flex-wrap:wrap;margin:2rem 0}.actions a,.closing a{padding:.75rem 1rem;border:1px solid #0f172a1b;border-radius:.75rem;font-weight:850;text-decoration:none}.actions .primary{background:var(--ink);color:white}.hero ul{display:flex;gap:1rem;flex-wrap:wrap;margin:0;padding:0;color:var(--muted);font-size:.8rem;list-style:none}.hero li:before{content:'◆';margin-right:.4rem;color:var(--accent)}.visual{position:relative;min-height:32rem;overflow:hidden;border-radius:2rem;background:radial-gradient(circle at 50% 50%,#8b5cf64f,transparent 38%),linear-gradient(145deg,#070b17,#16223c);box-shadow:0 35px 90px #0f172a45}.grid{position:absolute;inset:0;background-image:linear-gradient(#ffffff0d 1px,transparent 1px),linear-gradient(90deg,#ffffff0d 1px,transparent 1px);background-size:2.4rem 2.4rem}.visual svg{position:absolute;inset:0;width:100%;height:100%;fill:none;stroke:#a78bfa88;stroke-width:2}.node{position:absolute;z-index:2;display:grid;padding:.8rem;border:1px solid #ffffff24;border-radius:.9rem;background:#0f172bd9;color:#94a3b8;backdrop-filter:blur(12px);font:700 .64rem/1.5 ui-monospace,monospace;letter-spacing:.08em}.node b,.node strong{color:white}.node i{font-style:normal}.core{top:50%;left:50%;width:13rem;padding:1.2rem;transform:translate(-50%,-50%)}.core strong{font-size:1.25rem}.n1{top:10%;left:7%}.n2{top:10%;right:7%}.n3{bottom:10%;left:7%}.n4{right:7%;bottom:10%}.metrics{display:grid;grid-template-columns:repeat(4,1fr);overflow:hidden;border:1px solid #0f172a16;border-radius:1.15rem;background:#ffffffc7}.metrics div{display:grid;padding:1.2rem}.metrics div+div{border-left:1px solid #0f172a16}.metrics b{font-size:1.3rem}.metrics span{color:var(--muted);font-size:.76rem}.platform{padding:8rem 0}.platform h2,.sdk h2,.closing h2{max-width:15ch;margin:.55rem 0 1rem;font-size:clamp(2.6rem,6vw,5rem);line-height:.94;letter-spacing:-.06em}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:3rem}.features article{min-height:14rem;padding:1.3rem;border:1px solid #0f172a14;border-radius:1.1rem;background:#ffffffc2}.features small{color:var(--accent);font:800 .68rem/1 ui-monospace,monospace}.features h3{margin:2.1rem 0 .55rem}.features p{color:var(--muted)}.sdk{display:grid;grid-template-columns:minmax(0,.78fr) minmax(31rem,1.22fr);gap:clamp(2rem,7vw,6rem);align-items:center;margin:3rem 0 9rem}.source{display:inline-block;margin-top:1rem;color:var(--accent);font-weight:850;text-decoration:none}.workbench{overflow:hidden;border:1px solid #ffffff24;border-radius:1.25rem;background:#07101f;color:#dbeafe;box-shadow:0 32px 90px #07101f40}.toolbar{display:flex;gap:.8rem;align-items:end;padding:.85rem 1rem;border-bottom:1px solid #ffffff18;background:#0d182b}.toolbar label{display:grid;gap:.25rem}.toolbar label span{color:#94a3b8;font:700 .6rem/1 ui-monospace,monospace;letter-spacing:.13em;text-transform:uppercase}.toolbar select,.toolbar button{border:1px solid #ffffff28;border-radius:.58rem;background:#111e34;color:white;padding:.5rem .65rem;font:inherit}.toolbar button{margin-left:auto;cursor:pointer}.toolbar>code{align-self:center;color:#94a3b8;font-size:.75rem}.workbench pre{overflow:auto;min-height:22rem;max-height:29rem;margin:0;padding:1.2rem;font:500 .82rem/1.7 ui-monospace,monospace;white-space:pre}.workbench article>p{margin:0;padding:.8rem 1.2rem 1rem;border-top:1px solid #ffffff15;color:#94a3b8;font-size:.78rem}.closing{margin-bottom:2rem;padding:clamp(2rem,7vw,6rem);border-radius:1.8rem;background:linear-gradient(125deg,var(--accent),#2563eb);color:white}.closing .eyebrow{color:#ffffffc7}.closing a{display:inline-block;margin-top:1rem;background:white;color:var(--ink)}footer{display:flex;gap:1rem;padding:1.5rem 0 3rem;color:var(--muted);font-size:.78rem}footer span{margin-right:auto}footer a{text-decoration:none}@media(max-width:900px){.hero,.sdk{grid-template-columns:1fr}.features{grid-template-columns:1fr 1fr}}@media(max-width:650px){nav a:not(:last-child){display:none}.visual{min-height:26rem}.metrics{grid-template-columns:1fr 1fr}.features{grid-template-columns:1fr}.toolbar{align-items:stretch;flex-wrap:wrap}.toolbar>code{width:100%;order:3}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}</style>
</body></html>
